      b 
    }else{
      b * powi(b,e - 1)
    }
  }
}

def rev_acc(l:List,acc:List): List{
  l.case{
    Nil => acc,
    Cons(x,xs) => rev_acc(xs,Cons(x,acc))
  }
}

def rev(l:List): List{
