def digits(n:i64): List{
  if n / 10 == 0{
    Cons(n,Nil)
  }else{
    rev(Cons(n % 10, digits(n / 10)))
  }
}

def list_eq(l1:List,l2:List): Bool{
  l1.case{
    Nil => l2.case{
      Nil => True,
      Cons(x,xs) => False
    },
    Cons(x1,xs1) => l2.case{
      Nil => False,
      Cons(x2,xs2) => if x1 == x2 {
        list_eq(xs1,xs2)
      }else{
        False
      }
    }
  }
}

