  let next_max:i64 = if next_prod >= curr_max{
    is_palindrome(next_prod).case{
      True => next_prod,
      False => curr_max
      }
  }else{
    curr_max
  };
  let next_a: i64 = if a == max - 1{
    min
  }else{
     a + 1
  };
  let next_b: i64 = if next_a == min{
    b + 1
  }else{
    b
  };
  if next_b == max{
    curr_max
  }else{
      max_prod_between_rec(min,max,next_a,next_b,next_max)
  }
}

